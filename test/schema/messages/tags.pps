// A message with the tag numbers at the edges of the valid range.
message EdgeTags {

    // The minimum tag number.
    min: u32 = 1;

    // The maximum tag number.
    max: u32 = 8191;
}

// A message with the tag numbers out of declaration order.
message UnorderedTags {

    // The third tag number.
    three: u32 = 3;

    // The first tag number.
    one: u32 = 1;

    // The second tag number.
    two: u32 = 2;
}
