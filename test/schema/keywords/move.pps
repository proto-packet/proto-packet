// A message in a rust-keyword mod. (`move.pps` must generate `pub mod r#move;`)
message MoveTest {

    // The name.
    name: string = 1;

    // The nested value. (exercises the qualified `crate::keywords::r#move::` path)
    nested: MoveNested = 2;
}

// A nested test message.
message MoveNested {

    // The value.
    value: u32 = 1;
}
