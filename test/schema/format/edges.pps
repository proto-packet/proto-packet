import format.examples.Color;
import format.examples.Entry;
import format.examples.Point;

// A struct with a bit group of 2 bytes.
struct NineBits {

    // Bit 0.
    a: bool;

    // Bit 1.
    b: bool;

    // Bit 2.
    c: bool;

    // Bit 3.
    d: bool;

    // Bit 4.
    e: bool;

    // Bit 5.
    f: bool;

    // Bit 6.
    g: bool;

    // Bit 7.
    h: bool;

    // Bit 8.
    i: bool;
}

// A struct with a signed integer of each size.
struct SignedKinds {

    // An alignment 1 field.
    a: i8;

    // An alignment 2 field.
    b: i16;

    // An alignment 4 field.
    c: i32;

    // An alignment 8 field.
    d: i64;

    // A 16-byte field, of alignment 8.
    e: i128;

    // An optional field.
    f: optional i16;
}

// A struct with a float of each size.
struct FloatKinds {

    // An alignment 4 field.
    a: f32;

    // An alignment 8 field.
    b: f64;

    // An optional field.
    c: optional f32;
}

// A struct with a field of each time type.
struct TimeKinds {

    // The milliseconds since the epoch.
    at: timestamp;

    // The microseconds since the epoch.
    micro: microtime;

    // The nanoseconds since the epoch.
    nano: nanotime;

    // The days since the epoch, of alignment 4.
    day: date;

    // The nanoseconds of the span.
    span: duration;

    // An optional time.
    maybe: optional timestamp;

    // A list of dates.
    days: []date;

    // A map with time keys.
    spans: map<date, duration>;
}

// A struct with decimals.
struct Prices {

    // A price, with 2 fraction digits.
    price: decimal<2>;

    // A rate, with 6 fraction digits.
    rate: decimal<6>;

    // A whole number.
    count: decimal<0>;

    // An optional price.
    maybe: optional decimal<2>;

    // The prices.
    list: []decimal<2>;

    // The price of each name.
    named: map<string, decimal<2>>;
}

// A fixed struct of the other fixed-size types, with optional fields.
struct FixedKinds {

    // A UUID.
    id: uuid;

    // An enum.
    color: Color;

    // A boxed fixed struct.
    point: box Point;

    // An optional fixed struct, with a presence bit.
    maybe_point: optional Point;

    // An optional boxed enum.
    maybe_color: optional box Color;
}

// A struct with an optional variable struct before other entries.
struct AbsentChild {

    // An optional variable struct.
    first: optional Entry;

    // A variable struct, of alignment 8.
    second: Entry;

    // A string.
    text: string;
}

// A struct in a type loop, whose alignment comes from the other struct.
struct LoopByte {

    // An alignment 1 field.
    value: u8;

    // The other struct of the loop.
    next: optional box LoopLong;
}

// A struct in a type loop, with the largest alignment of the loop.
struct LoopLong {

    // An alignment 8 field.
    value: u64;

    // The other struct of the loop.
    next: optional box LoopByte;
}

// A struct with strings around a variable struct.
struct Strings {

    // The number.
    number: u8;

    // The first string.
    first: string;

    // The variable struct, between the strings in the tail.
    entry: Entry;

    // An optional string.
    second: optional string;

    // The last string.
    third: string;
}
