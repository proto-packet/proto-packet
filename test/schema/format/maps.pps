import format.examples.Color;
import format.examples.Entry;
import format.examples.Point;
import format.variants.NewerCases;
import format.variants.OlderCases;

// The `Scores` example of `format/binary.md`.
struct Scores {

    // The score of each name.
    scores: map<string, u32>;
}

// A struct with a map of each kind.
struct MapKinds {

    // A map with fixed-size keys & values.
    by_number: map<u32, bool>;

    // A map with enum keys.
    by_color: map<Color, string>;

    // A map with struct keys & values.
    by_point: map<Point, Entry>;

    // A map of lists.
    lists: map<string, []u8>;

    // A map of maps.
    maps: map<u8, map<u8, u8>>;

    // An optional map.
    maybe: optional map<i64, f64>;
}

// A message with a map.
message WithMaps {

    // The score of each name.
    scores: map<string, u32> = 1;

    // A list of maps.
    rounds: []map<u8, u8> = 2;
}

// A variant with a map.
variant MapCases {

    // The score of each name.
    Scores: map<string, u32> = 1;

    // A number, so a case has a setter in place.
    Number: u32 = 2;
}

// An older version of a key.
message OlderKey {

    // The first number.
    a: u32 = 1;

    // The last number.
    c: u32 = 3;
}

// A newer version of a key, with a field between the older version's.
message NewerKey {

    // The first number.
    a: u32 = 1;

    // A new number.
    b: u32 = 2;

    // The last number.
    c: u32 = 3;
}

// The maps of an older reader, with keys that are ordered by their bytes.
struct OlderKeys {

    // A map with message keys.
    by_message: map<OlderKey, u8>;

    // A map with variant keys.
    by_variant: map<OlderCases, u8>;
}

// The maps of a newer writer, with keys that are ordered by their bytes.
struct NewerKeys {

    // A map with message keys.
    by_message: map<NewerKey, u8>;

    // A map with variant keys.
    by_variant: map<NewerCases, u8>;
}

// A struct with a message inside it, so a key of it is ordered by its bytes.
struct Tagged {

    // A number, so the struct has an alignment of 8.
    id: u64;

    // A message.
    key: NewerKey;
}

// A struct with keys that have a message inside them.
struct NestedKeys {

    // A map with struct keys & padded values.
    by_struct: map<Tagged, Entry>;

    // A map with list keys.
    by_list: map<[]NewerKey, u8>;
}
