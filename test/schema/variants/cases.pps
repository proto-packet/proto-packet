// A variant with a single boolean case.
variant BooleanCase {

    // A `bool` case.
    One: bool = 1;
}

// A variant with unsigned integer cases.
variant UnsignedIntCases {

    // A `u8` case.
    One: u8 = 1;

    // A `u16` case.
    Two: u16 = 2;

    // A `u32` case.
    Three: u32 = 3;

    // A `u64` case.
    Four: u64 = 4;

    // A `u128` case.
    Five: u128 = 5;
}

// A variant with signed integer cases.
variant SignedIntCases {

    // An `i8` case.
    One: i8 = 1;

    // An `i16` case.
    Two: i16 = 2;

    // An `i32` case.
    Three: i32 = 3;

    // An `i64` case.
    Four: i64 = 4;

    // An `i128` case.
    Five: i128 = 5;
}

// A variant with floating point cases.
variant FloatCases {

    // An `f32` case.
    One: f32 = 1;

    // An `f64` case.
    Two: f64 = 2;
}

// A variant with special cases.
variant SpecialCases {

    // A `uuid` case.
    One: uuid = 1;

    // A `string` case.
    Two: string = 2;
}

// A variant with time cases.
variant TimeCases {

    // A `timestamp` case.
    One: timestamp = 1;
}
