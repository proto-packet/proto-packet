import types.Color;
import types.Label;
import types.Path;
import types.Point;
import types.Shape;

// A variant with boxed cases of each kind of named type.
variant BoxedCases {

    // A boxed `Copy` struct case.
    Point: box Point = 1;

    // A boxed non-`Copy` struct case.
    Path: box Path = 2;

    // A boxed message case.
    Label: box Label = 3;

    // A boxed enum case.
    Color: box Color = 4;

    // A boxed variant case.
    Shape: box Shape = 5;
}
