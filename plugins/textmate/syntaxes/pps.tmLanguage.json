{
  "name": "ProtoPacket Schema",
  "scopeName": "source.pps",
  "patterns": [
    { "include": "#comment" },
    { "include": "#import" },
    { "include": "#declaration" },
    { "include": "#member" },
    { "include": "#case" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.pps",
      "match": "//.*$"
    },
    "import": {
      "match": "\\b(import)\\s+((?:[A-Za-z_][A-Za-z0-9_]*\\s*\\.\\s*)*)([A-Za-z_][A-Za-z0-9_]*)?",
      "captures": {
        "1": { "name": "keyword.control.import.pps" },
        "2": { "name": "entity.name.namespace.pps" },
        "3": { "name": "entity.name.type.pps" }
      }
    },
    "declaration": {
      "match": "\\b(struct|message|enum|variant|service)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.pps" },
        "2": { "name": "entity.name.type.pps" }
      }
    },
    "member": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
      "captures": {
        "1": { "name": "variable.other.member.pps" }
      }
    },
    "case": {
      "match": "(?:^|(?<=[{;]))\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?==)",
      "captures": {
        "1": { "name": "variable.other.enummember.pps" }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "storage.modifier.pps",
          "match": "\\b(optional|box)\\b"
        },
        {
          "name": "keyword.other.returns.pps",
          "match": "\\breturns\\b"
        },
        {
          "name": "storage.type.pps",
          "match": "\\b(struct|message|enum|variant|service)\\b"
        },
        {
          "name": "keyword.control.import.pps",
          "match": "\\bimport\\b"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "storage.type.primitive.pps",
          "match": "\\b(bool|u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|f32|f64|timestamp|microtime|nanotime|date|duration|uuid|string|decimal|map)\\b"
        },
        {
          "match": "\\b((?:[a-z_][A-Za-z0-9_]*\\s*\\.\\s*)+)([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.pps" },
            "2": { "name": "entity.name.type.pps" }
          }
        },
        {
          "name": "entity.name.type.pps",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.pps",
      "match": "\\b[0-9]+\\b"
    }
  }
}
